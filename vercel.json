{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" },
    { "src": "icons/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/portal.html" },
    { "src": "/ide", "dest": "/index.html" },
    { "src": "/deploy", "dest": "/deploy-hub.html" }
  ]
}
