{
  "name": "puterlab-nexus-ide",
  "version": "1.0.0",
  "description": "PuterLab Nexus IDE — Entorno de Desarrollo Web y de Escritorio con Co-Agente IA",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "echo 'Static build complete'",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg"
  },
  "keywords": [
    "ide",
    "editor",
    "puter",
    "ai",
    "agent",
    "vscode",
    "electron"
  ],
  "author": "ARKAIOS",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.arkaios.puterlab",
    "productName": "PuterLab Nexus IDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  }
}
